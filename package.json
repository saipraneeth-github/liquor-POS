{
  "name": "liquor-counter",
  "version": "0.1.0",
  "description": "Liquor Counter POS & Inventory Management Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "node --import tsx src/dev-local.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^10.1.7",
    "@napi-rs/canvas": "^1.0.11",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.36.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.9.1",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.28.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.18.20": true
  }
}
