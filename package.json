{
  "name": "liquor-counter",
  "version": "0.1.0",
  "description": "Liquor Counter POS & Inventory Management Platform",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:local": "node --import tsx src/dev-local.ts",
    "build": "npm run build:frontend && tsc",
    "prestart": "npm run build",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --fileParallelism=false",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "super-admin": "node --env-file=.env --import tsx src/db/create-super-admin.ts",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "db:clear-inventory": "node --env-file=.env --import tsx src/db/clear-inventory.ts",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^10.1.8",
    "@napi-rs/canvas": "^1.0.11",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "postgres": "^3.4.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.9.1",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.28.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true
  }
}
