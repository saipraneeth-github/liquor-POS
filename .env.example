# Database
# Real PostgreSQL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/liquor_counter
# Or embedded PGlite (no install needed): DATABASE_URL=pglite://./.pglite

# Auth
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# Allowed browser origin(s), comma separated. REQUIRED in production (not "*"), e.g. https://pos.example.com
# CORS_ORIGIN=http://localhost:5173
# Behind a reverse proxy / load balancer set this so rate limits and the login lockout see the real client IP:
# "true", a number of proxy hops (e.g. 1), or a comma-separated list of proxy IPs/CIDRs. Unset = clients connect directly.
# TRUST_PROXY=1
# Set to 0 to disable the public-DNS fallback used when the system resolver cannot find the database host
# DB_DNS_FALLBACK=1

# Server
PORT=3001
NODE_ENV=development

# Redis (Phase 2 - BullMQ)
# REDIS_URL=redis://localhost:6379

# ─── Integrations (all optional; see INTEGRATIONS.md) ───────────────────────────
# Public address of the web app. Used for links in e-mails (password reset, billing reminders).
APP_URL=http://localhost:3001

# Payment gateway: razorpay | mock (default: mock = built-in test gateway, no real money)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in the Razorpay dashboard (Settings -> Webhooks); URL: <APP_URL>/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# PRODUCTION REFUSES TO START on the built-in test gateway (it lets a tenant Admin mark invoices paid for free).
# Use razorpay above, or set ALLOW_MOCK_PAYMENTS=1 for a demo/staging deployment and also set MOCK_PAYMENT_SECRET.
# ALLOW_MOCK_PAYMENTS=0
# MOCK_PAYMENT_SECRET=

# E-mail through any SMTP server. Leave SMTP_HOST empty to only store e-mails in the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Liquor Counter <billing@yourcompany.com>"

# Billing reminders / automatic invoices: set to 0 to switch the daily job off
BILLING_JOB_ENABLED=1
